# Database
DB_URL=jdbc:mysql://your-host:4000/wissfind?useSSL=true&requireSSL=true&serverTimezone=Asia/Kolkata
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# JWT
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
JWT_EXPIRATION_MS=86400000

# Ninza SMS OTP
# Keep the real Authorization token only in backend/.env or your deployment secret manager.
NINZA_SMS_AUTH=your_ninza_authorization_token
NINZA_SMS_SENDER_ID=your_sender_id
NINZA_SMS_BASE_URL=https://ninzasms.in.net/auth/send_sms.php
OTP_TTL_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_EXPOSE_DEV=false

# Razorpay TEST MODE keys from Razorpay Dashboard
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
